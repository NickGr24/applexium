# Cloudflare Pages / Workers static-assets headers file. Copied into dist/ by
# the build (public/ is served verbatim) and parsed by the host; GitHub Pages
# ignores it, which is harmless. verify-dist asserts it lands in dist/.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Vite fingerprints everything under /assets/ (content hash in the filename),
# so a file at a given path never changes: cache it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
